---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { slugify, initials, monoColor } from '../lib/util';
import authors from '../data/authors.json';

const posts = await getCollection('posts');
const counts:Record<string,number> = {};
for(const p of posts){ const a=p.data.author; if(a) counts[a]=(counts[a]||0)+1; }
const list = Object.entries(counts).map(([name,count])=>{
  const prof:any = (authors as any)[slugify(name)] || {};
  return { name, count, hash: prof.hash||'', img: prof.img||'', bio: prof.bio||'' };
}).sort((a,b)=> b.count-a.count || a.name.localeCompare(b.name,'es'));
const withAuthor = list.reduce((s,a)=>s+a.count,0);
---
<Base title="Autores" description={`Los ${list.length} autores del archivo de La Trinchera: teoría, política y cultura desde Cuba (2018–2021).`}>
  <section class="wrap head">
    <p class="kicker">La Trinchera · Archivo</p>
    <h1>Autores</h1>
    <p class="lede">{list.length} autores han escrito los {withAuthor} textos con firma del archivo. Haz clic en cualquiera para ver todos sus textos.</p>
    <div class="controls">
      <input id="q" type="search" aria-label="Buscar autor" placeholder="Buscar autor…" autocomplete="off" />
      <div class="sort" role="group" aria-label="Ordenar autores">
        <span class="sort-l">Ordenar</span>
        <button type="button" class="sb active" data-sort="count">Más textos</button>
        <button type="button" class="sb" data-sort="name">A–Z</button>
      </div>
    </div>
    <p id="found" class="found"></p>
  </section>
  <section class="wrap grid" id="grid">
    {list.map(a=> (
      <a class="card" href={`/autor/${slugify(a.name)}/`} data-name={a.name.toLowerCase()} data-count={a.count}>
        {a.img
          ? <img class="av photo" src={a.img} alt="" width="56" height="56" loading="lazy" />
          : a.hash
          ? <img class="av" src={`https://www.gravatar.com/avatar/${a.hash}?s=140`} alt="" width="56" height="56" loading="lazy" />
          : <span class="av mono" style={`background:${monoColor(a.name)}`}>{initials(a.name)}</span>}
        <span class="who">
          <span class="name">{a.name}</span>
          <span class="count">{a.count} {a.count===1?'texto':'textos'}</span>
          {a.bio && <span class="bio">{a.bio.length>92 ? a.bio.slice(0,92).replace(/\s+\S*$/,'')+'…' : a.bio}</span>}
        </span>
      </a>
    ))}
    <p id="empty" class="empty" hidden>No hay autores que coincidan con tu búsqueda.</p>
  </section>
  <nav class="wrap pager" id="pager" aria-label="Paginación" hidden>
    <button type="button" class="pg" id="prev">← Anterior</button>
    <span class="pgtxt" id="pageind"></span>
    <button type="button" class="pg" id="next">Siguiente →</button>
  </nav>
  <style>
    .head{padding:2.4rem 1.2rem 1rem;max-width:760px}
    .head .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;margin:0;font-weight:700}
    .head h1{font-size:clamp(2rem,6vw,2.8rem);margin:.15em 0 .1em}
    .head .lede{color:var(--muted);margin:.2rem 0 1.1rem}
    .controls{display:flex;flex-wrap:wrap;gap:.7rem 1rem;align-items:center}
    #q{flex:1 1 260px;max-width:420px;padding:.6rem .9rem;border:1px solid var(--line);border-radius:9px;background:var(--paper);color:var(--ink);font-size:.95rem}
    #q:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
    .sort{display:flex;align-items:center;gap:.35rem}
    .sort-l{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:700;margin-right:.1rem}
    .sb{font-family:inherit;font-size:.82rem;color:var(--muted);background:var(--paper);border:1px solid var(--line);
      border-radius:20px;padding:.4rem .8rem;cursor:pointer;transition:.15s}
    .sb:hover{border-color:var(--accent);color:var(--accent)}
    .sb.active{background:var(--accent);border-color:var(--accent);color:#fff}
    .found{color:var(--muted);font-size:.8rem;margin:.6rem 0 0;min-height:1em}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:.9rem;padding:1.2rem 1.2rem 1.4rem}
    .card{display:flex;gap:.75rem;align-items:flex-start;background:var(--paper);border:1px solid var(--line);
      border-radius:11px;padding:.9rem 1rem;text-decoration:none;color:inherit;transition:.15s}
    .card:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(40,25,20,.06);border-color:var(--accent)}
    .av{width:52px;height:52px;border-radius:50%;flex:0 0 auto;object-fit:cover;display:grid;place-items:center;
      font-family:Georgia,serif;font-weight:700;font-size:1.15rem;color:#fbf6ef;border:1px solid rgba(0,0,0,.06)}
    .who{display:flex;flex-direction:column;min-width:0}
    .name{font-family:var(--display);font-weight:700;font-size:1.1rem;line-height:1.2}
    .card:hover .name{color:var(--accent)}
    .count{color:var(--muted);font-size:.78rem;margin-top:.05rem}
    .bio{color:var(--muted);font-size:.82rem;margin-top:.35rem;line-height:1.45}
    .empty{grid-column:1/-1;color:var(--muted);text-align:center;padding:2rem}
    .pager{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;justify-content:center;padding:.4rem 1.2rem 2.6rem}
    .pg{font-family:inherit;padding:.45rem .85rem;border:1px solid var(--line);border-radius:8px;background:var(--paper);
      color:var(--accent);cursor:pointer;font-size:.85rem;font-weight:600}
    .pg:hover:not(:disabled){background:var(--accent);color:#fff;border-color:var(--accent)}
    .pg:disabled{opacity:.4;cursor:default;color:var(--muted)}
    .pgtxt{color:var(--muted);font-size:.85rem;margin:0 .4rem}
    @media (max-width:560px){ .grid{grid-template-columns:1fr} }
  </style>
  <script is:inline>
    (function(){
      var PER=24;
      var grid=document.getElementById('grid'), q=document.getElementById('q'), found=document.getElementById('found');
      var empty=document.getElementById('empty'), pager=document.getElementById('pager');
      var prevb=document.getElementById('prev'), nextb=document.getElementById('next'), pageind=document.getElementById('pageind');
      var cards=[].slice.call(grid.querySelectorAll('.card'));
      var state={sort:'count', query:'', page:1};
      function norm(s){return (s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'');}
      function apply(){
        var v=norm(state.query.trim());
        var vis=cards.filter(function(c){ return !v || norm(c.getAttribute('data-name')).indexOf(v)>=0; });
        vis.sort(function(a,b){
          var an=a.getAttribute('data-name'), bn=b.getAttribute('data-name');
          if(state.sort==='name') return an.localeCompare(bn,'es');
          return (+b.getAttribute('data-count'))-(+a.getAttribute('data-count')) || an.localeCompare(bn,'es');
        });
        vis.forEach(function(c){ grid.appendChild(c); });
        var pages=Math.max(1,Math.ceil(vis.length/PER));
        if(state.page>pages) state.page=pages;
        if(state.page<1) state.page=1;
        var start=(state.page-1)*PER, end=start+PER;
        cards.forEach(function(c){ c.hidden=true; });
        vis.forEach(function(c,i){ c.hidden = i<start || i>=end; });
        found.textContent = state.query.trim() ? (vis.length+' de '+cards.length+' autores') : '';
        empty.hidden = vis.length!==0;
        if(pages>1){ pager.hidden=false; pageind.textContent='Página '+state.page+' de '+pages;
          prevb.disabled=state.page<=1; nextb.disabled=state.page>=pages; }
        else pager.hidden=true;
      }
      q.addEventListener('input',function(){ state.query=q.value; state.page=1; apply(); });
      [].slice.call(document.querySelectorAll('.sb')).forEach(function(b){
        b.addEventListener('click',function(){
          state.sort=b.getAttribute('data-sort'); state.page=1;
          document.querySelectorAll('.sb').forEach(function(x){ x.classList.toggle('active', x===b); });
          apply();
        });
      });
      prevb.addEventListener('click',function(){ state.page--; apply(); window.scrollTo({top:0,behavior:'smooth'}); });
      nextb.addEventListener('click',function(){ state.page++; apply(); window.scrollTo({top:0,behavior:'smooth'}); });
      apply();
    })();
  </script>
</Base>
