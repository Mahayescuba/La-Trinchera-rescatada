---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fixCat, slugify, fmtDate, excerpt, initials, monoColor, thumbData } from '../lib/util';
import { buildSeries } from '../lib/series';
import { pickCover } from '../lib/covers';
import authors from '../data/authors.json';
export async function getStaticPaths(){
  const posts = await getCollection('posts');
  const { bySlug: seriesBySlug } = buildSeries(posts);
  const seriesInfoFor=(p:any)=>{
    const s = seriesBySlug.get(p.slug);
    if(!s) return null;
    const index = s.parts.findIndex((x:any)=>x.slug===p.slug);
    return { base:s.base, index, parts:s.parts.map((x:any)=>({slug:x.slug,title:x.title})) };
  };
  const counts:Record<string,number> = {};
  const cats:Record<string,Record<string,number>> = {};
  for(const x of posts){ const a=x.data.author; if(!a) continue;
    counts[a]=(counts[a]||0)+1;
    const c=fixCat(x.data.category);
    if(c && c!=='Sin categoría'){ (cats[a] ??= {}); cats[a][c]=(cats[a][c]||0)+1; }
  }
  const topCatOf=(a:string)=>{ const e=Object.entries(cats[a]||{}).sort((x,y)=>y[1]-x[1])[0]; return e?e[0]:''; };
  // índices para "Sigue leyendo" (mismo autor o misma categoría), preordenados por fecha desc
  const byDate=(a:any,b:any)=> (b.data.date||'').localeCompare(a.data.date||'');
  const byAuthor:Record<string,any[]> = {}; const byCat:Record<string,any[]> = {};
  for(const x of posts){
    const a=x.data.author; if(a){ (byAuthor[a] ??= []).push(x); }
    const c=fixCat(x.data.category); if(c && c!=='Sin categoría'){ (byCat[c] ??= []).push(x); }
  }
  for(const k in byAuthor) byAuthor[k].sort(byDate);
  for(const k in byCat) byCat[k].sort(byDate);
  const relatedFor=(p:any)=>{
    const seen=new Set([p.slug]); const out:any[]=[];
    const add=(arr:any[])=>{ for(const x of (arr||[])){ if(out.length>=3) break; if(seen.has(x.slug)) continue; seen.add(x.slug); out.push({slug:x.slug,title:x.data.title,author:x.data.author,date:x.data.date,cat:fixCat(x.data.category)}); } };
    if(p.data.author) add(byAuthor[p.data.author]);
    add(byCat[fixCat(p.data.category)]);
    return out;
  };
  // navegación cronológica dentro de la misma categoría
  const catNavFor=(p:any)=>{
    const c=fixCat(p.data.category);
    const arr = (c && c!=='Sin categoría') ? (byCat[c]||[]) : [];
    const idx = arr.findIndex((x:any)=>x.slug===p.slug);
    if(idx<0) return null;
    const lite=(x:any)=> x ? { slug:x.slug, title:x.data.title } : null;
    return { cat:c, older:lite(arr[idx+1]), newer:lite(arr[idx-1]) };
  };
  return posts.map(p=> ({ params:{ slug:p.slug }, props:{ p, count: p.data.author ? counts[p.data.author] : 0, topCat: p.data.author ? topCatOf(p.data.author) : '', related: relatedFor(p), catNav: catNavFor(p), series: seriesInfoFor(p) } }));
}
const { p, count, topCat, related, catNav, series } = Astro.props;
const { Content } = await p.render();
const desc = excerpt(p.body, 155);
const lead = p.data.image ? thumbData(p.data.image, 1200) : null;
const cover = lead ? null : pickCover(p);   // texto sin imagen: portada de archivo (CC0) con crédito
const prof:any = p.data.author ? ((authors as any)[slugify(p.data.author)] || {}) : null;
const readMin = Math.max(1, Math.round(p.body.trim().split(/\s+/).length / 200));
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const year = p.data.date ? new Date(p.data.date).getFullYear() : '';
const cite = `${p.data.author ? p.data.author+'. ' : ''}${year?`(${year}). `:''}«${p.data.title}». La Trinchera. ${pageUrl}`;
const share = {
  x: `https://twitter.com/intent/tweet?text=${encodeURIComponent(p.data.title)}&url=${encodeURIComponent(pageUrl)}`,
  fb: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`,
  wa: `https://wa.me/?text=${encodeURIComponent(p.data.title+' '+pageUrl)}`,
  tg: `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(p.data.title)}`,
};
const jsonLd = {
  '@context':'https://schema.org','@type':'Article',
  headline: p.data.title,
  ...(p.data.author ? { author:{ '@type':'Person', name:p.data.author } } : {}),
  ...(p.data.date ? { datePublished:p.data.date } : {}),
  ...(p.data.image ? { image:new URL(p.data.image, Astro.site).href } : {}),
  publisher:{ '@type':'Organization', name:'La Trinchera' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  ...(series ? { isPartOf:{ '@type':'CreativeWorkSeries', name:series.base } } : {}),
};
const catName = p.data.category ? fixCat(p.data.category) : '';
const hasCat = !!catName && catName!=='Sin categoría';
const crumbLd = {
  '@context':'https://schema.org','@type':'BreadcrumbList',
  itemListElement:[
    { '@type':'ListItem', position:1, name:'Inicio', item:new URL('/', Astro.site).href },
    ...(hasCat ? [{ '@type':'ListItem', position:2, name:catName, item:new URL(`/categoria/${slugify(catName)}/`, Astro.site).href }] : []),
    { '@type':'ListItem', position: hasCat?3:2, name:p.data.title, item:pageUrl },
  ],
};
---
<Base title={p.data.title} description={desc} image={p.data.image || (cover ? cover.file : undefined)} type="article">
  <article class="wrap post">
    <nav class="crumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      {p.data.category && fixCat(p.data.category)!=='Sin categoría' && (
        <><span class="sep">›</span><a href={`/categoria/${slugify(fixCat(p.data.category))}/`}>{fixCat(p.data.category)}</a></>
      )}
    </nav>
    <h1>{p.data.title}</h1>
    <p class="meta">
      {p.data.author
        ? <span>Por <a href={`/autor/${slugify(p.data.author)}/`}>{p.data.author}</a></span>
        : <span class="anon">Autoría no identificada</span>}
      {p.data.date && <span> · <time datetime={p.data.date}>{fmtDate(p.data.date)}</time></span>}
      <span> · {readMin} min de lectura</span>
    </p>
    {lead && <img class="lead" src={lead.src} alt={p.data.title} width={lead.w} height={lead.h} loading="eager" fetchpriority="high" decoding="async" />}
    {cover && (
      <figure class="archcover">
        <img class="lead" src={cover.file} alt={`Portada del archivo: ${cover.title}, de ${cover.artist}`} loading="eager" fetchpriority="high" decoding="async" />
        <figcaption class="archcredit">
          <span class="ac-tag">Portada del archivo</span>
          <span class="ac-src">{cover.title} · <b>{cover.artist}</b>{cover.date?`, ${cover.date}`:''} — <a href={cover.url} target="_blank" rel="noopener">dominio público, The Met</a></span>
        </figcaption>
      </figure>
    )}
    <div class="body"><Content /></div>
    {series && (
      <section class="serie" aria-label={`Serie: ${series.base}`}>
        <p class="serie-h">Serie · {series.parts.length} entregas</p>
        <p class="serie-base">{series.base}</p>
        <ol class="serie-list">
          {series.parts.map((sp:any,i:number)=> (
            <li class={i===series.index ? 'cur' : ''}>
              <span class="serie-n">{i+1}</span>
              {i===series.index
                ? <span class="serie-t">{sp.title} <em>· estás aquí</em></span>
                : <a class="serie-t" href={`/${sp.slug}/`}>{sp.title}</a>}
            </li>
          ))}
        </ol>
      </section>
    )}
    <div class="share">
      <span class="share-l">Compartir</span>
      <a href={share.x} target="_blank" rel="noopener">X</a>
      <a href={share.fb} target="_blank" rel="noopener">Facebook</a>
      <a href={share.wa} target="_blank" rel="noopener">WhatsApp</a>
      <a href={share.tg} target="_blank" rel="noopener">Telegram</a>
      <button type="button" class="copybtn" data-copy={pageUrl}>Copiar enlace</button>
    </div>
    {p.data.author && (
      <aside class="authorcard">
        {prof.hash
          ? <img class="ac-av" src={`https://www.gravatar.com/avatar/${prof.hash}?s=160`} alt={p.data.author} width="64" height="64" loading="lazy" />
          : <span class="ac-av ac-mono" style={`background:${monoColor(p.data.author)}`}>{initials(p.data.author)}</span>}
        <div class="ac-body">
          <span class="ac-label">Autor</span>
          <a class="ac-name" href={`/autor/${slugify(p.data.author)}/`}>{p.data.author}</a>
          {prof.bio && <p class="ac-bio">{prof.bio}</p>}
          <p class="ac-meta">
            <a href={`/autor/${slugify(p.data.author)}/`}>{count} {count===1?'texto':'textos'} en La Trinchera</a>
            {topCat && <a class="ac-link" href={`/categoria/${slugify(topCat)}/`}>{topCat}</a>}
            {prof.links && prof.links.map((l:string)=> (
              <a class="ac-link" href={l} target="_blank" rel="noopener">{l.startsWith('mailto:')?'correo':'sitio'}</a>
            ))}
          </p>
        </div>
      </aside>
    )}
    {catNav && (catNav.older || catNav.newer) && (
      <nav class="catnav" aria-label={`Más en ${catNav.cat}`}>
        {catNav.older
          ? <a class="cn cn-prev" href={`/${catNav.older.slug}/`}><span class="cn-dir">← Anterior en {catNav.cat}</span><span class="cn-t">{catNav.older.title}</span></a>
          : <span class="cn cn-empty" aria-hidden="true"></span>}
        {catNav.newer
          ? <a class="cn cn-next" href={`/${catNav.newer.slug}/`}><span class="cn-dir">Siguiente en {catNav.cat} →</span><span class="cn-t">{catNav.newer.title}</span></a>
          : <span class="cn cn-empty" aria-hidden="true"></span>}
      </nav>
    )}
    {related && related.length>0 && (
      <section class="more">
        <h2>Sigue leyendo</h2>
        <div class="more-grid">
          {related.map((r:any)=> (
            <a class="more-card" href={`/${r.slug}/`}>
              {r.cat && <span class="more-cat">{r.cat}</span>}
              <span class="more-title">{r.title}</span>
              <span class="more-meta">{r.author && `${r.author} · `}{fmtDate(r.date)}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <details class="cite">
      <summary>Cómo citar este texto</summary>
      <p class="cite-text" id="cite-text">{cite}</p>
      <button type="button" class="copybtn" data-copy={cite}>Copiar cita</button>
    </details>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <script type="application/ld+json" set:html={JSON.stringify(crumbLd)}></script>
  <style>
    .post{max-width:720px;padding:2rem 1.2rem 1rem;overflow-wrap:break-word}
    .crumbs{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;font-size:.78rem;margin-bottom:1.1rem;
      text-transform:uppercase;letter-spacing:.08em}
    .crumbs a{color:var(--muted)}
    .crumbs a:hover{color:var(--accent)}
    .crumbs a:last-child{color:var(--accent);font-weight:600}
    .crumbs .sep{color:var(--muted);opacity:.6}
    .post h1{font-size:2.3rem;margin:.25em 0 .1em}
    .post .meta{color:var(--muted);font-size:.9rem;margin:.2rem 0 1.3rem}
    .post .meta a{color:var(--accent)}
    .post .meta .anon{font-style:italic;opacity:.7}
    img.lead{width:100%;height:auto;border-radius:8px;margin:.5rem 0 1.5rem;background:#efe9e0}
    .archcover{margin:.5rem 0 1.5rem}
    .archcover img.lead{margin:0 0 .5rem}
    .archcredit{display:flex;flex-wrap:wrap;align-items:baseline;gap:.5rem;font-size:.76rem;color:var(--muted);line-height:1.5}
    .ac-tag{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:#fff;background:var(--accent);
      padding:.16rem .45rem;border-radius:4px;flex:0 0 auto}
    .archcredit .ac-src b{color:var(--ink);font-weight:600}
    .archcredit a{color:var(--accent);text-decoration:underline;text-underline-offset:2px}
    .body{font-family:Georgia,"Times New Roman",serif;font-size:1.14rem;line-height:1.8;overflow-wrap:break-word;word-break:break-word}
    .body :global(p){margin:0 0 1.15em}
    .body :global(img){max-width:100%;height:auto;border-radius:6px;margin:1rem 0}
    .body :global(iframe){display:block;max-width:100%;margin:1.2rem 0;border:0}
    .body :global(iframe[src*="youtube"]),.body :global(iframe[src*="youtu.be"]){width:100%;height:auto;aspect-ratio:16/9}
    .body :global(h2),.body :global(h3){margin:1.6em 0 .4em}
    .body :global(blockquote){border-left:3px solid var(--accent);margin:1.2em 0;padding:.2em 1.1em;color:var(--muted);font-style:italic}
    .body :global(a){color:var(--accent);text-decoration:underline;text-underline-offset:2px}
    .authorcard{display:flex;gap:1rem;align-items:flex-start;margin:2.6rem 0 .5rem;padding:1.2rem 1.3rem;
      background:var(--paper);border:1px solid var(--line);border-radius:12px}
    .ac-av{width:64px;height:64px;border-radius:50%;flex:0 0 auto;object-fit:cover;display:grid;place-items:center;
      font-family:Georgia,serif;font-weight:700;font-size:1.4rem;color:#fbf6ef;border:1px solid rgba(0,0,0,.06)}
    .ac-body{min-width:0}
    .ac-label{display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:var(--accent);font-weight:700}
    .ac-name{font-family:var(--display);font-size:1.3rem;font-weight:700;line-height:1.2;display:inline-block;margin:.1rem 0}
    .ac-name:hover{color:var(--accent)}
    .ac-bio{margin:.35rem 0 .55rem;color:var(--muted);font-size:.92rem;line-height:1.55}
    .ac-meta{margin:0;font-size:.82rem;display:flex;gap:.9rem;flex-wrap:wrap;align-items:center}
    .ac-meta a{color:var(--accent)}
    .ac-link{text-transform:uppercase;letter-spacing:.05em;font-size:.72rem;font-weight:600}
    .share{display:flex;flex-wrap:wrap;gap:.5rem;align-items:center;margin:2.2rem 0 .5rem;
      padding-top:1.2rem;border-top:1px solid var(--line)}
    .share-l{font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;color:var(--muted);font-weight:700;margin-right:.2rem}
    .share a,.share .copybtn{font-size:.82rem;color:var(--accent);border:1px solid var(--line);background:var(--paper);
      border-radius:20px;padding:.32rem .8rem;text-decoration:none;cursor:pointer;font-family:inherit;line-height:1}
    .share a:hover,.share .copybtn:hover{background:var(--accent);color:#fff;border-color:var(--accent)}
    .serie{margin:2rem 0 .5rem;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:10px;
      background:var(--paper);padding:1.1rem 1.2rem}
    .serie-h{font-size:.68rem;text-transform:uppercase;letter-spacing:.14em;color:var(--accent);font-weight:700;margin:0}
    .serie-base{font-family:var(--display);font-weight:700;font-size:1.25rem;line-height:1.2;margin:.2rem 0 .7rem}
    .serie-list{list-style:none;margin:0;padding:0;counter-reset:none}
    .serie-list li{display:flex;gap:.7rem;align-items:baseline;padding:.35rem 0;border-top:1px solid var(--line)}
    .serie-list li:first-child{border-top:0}
    .serie-n{flex:0 0 auto;width:1.6rem;height:1.6rem;display:grid;place-items:center;border-radius:50%;
      background:var(--bg);color:var(--muted);font-size:.72rem;font-weight:700;font-variant-numeric:tabular-nums}
    .serie-list li.cur .serie-n{background:var(--accent);color:#fff}
    .serie-t{font-size:.95rem;line-height:1.35}
    a.serie-t{color:inherit}
    a.serie-t:hover{color:var(--accent)}
    .serie-list li.cur .serie-t{color:var(--ink);font-weight:600}
    .serie-t em{font-style:normal;color:var(--muted);font-size:.78rem;font-weight:400}
    .catnav{display:grid;grid-template-columns:1fr 1fr;gap:.8rem;margin:2.4rem 0 .5rem;padding-top:1.4rem;border-top:1px solid var(--line)}
    .cn{display:flex;flex-direction:column;gap:.25rem;padding:.9rem 1rem;border:1px solid var(--line);border-radius:10px;
      background:var(--paper);text-decoration:none;color:inherit;transition:.15s}
    .cn:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 8px 22px rgba(40,25,20,.06)}
    .cn-next{text-align:right;align-items:flex-end}
    .cn-dir{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-weight:700}
    .cn-t{font-family:var(--display);font-weight:700;font-size:1rem;line-height:1.25}
    .cn-empty{border:0;background:none}
    @media (max-width:560px){ .catnav{grid-template-columns:1fr} .cn-next{text-align:left;align-items:flex-start} }
    .more{margin:2.4rem 0 .5rem}
    .more h2{font-size:1.35rem;margin:0 0 .9rem;padding-top:1.2rem;border-top:1px solid var(--line)}
    .more-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.9rem}
    .more-card{display:flex;flex-direction:column;gap:.3rem;background:var(--paper);border:1px solid var(--line);
      border-radius:10px;padding:.9rem 1rem;text-decoration:none;color:inherit;transition:.15s}
    .more-card:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(40,25,20,.06);border-color:var(--accent)}
    .more-cat{font-size:.66rem;text-transform:uppercase;letter-spacing:.1em;color:var(--accent);font-weight:700}
    .more-title{font-family:var(--display);font-weight:700;font-size:1.02rem;line-height:1.25}
    .more-card:hover .more-title{color:var(--accent)}
    .more-meta{color:var(--muted);font-size:.76rem;margin-top:auto}
    @media (max-width:640px){ .more-grid{grid-template-columns:1fr} }
    .cite{margin:1.4rem 0 .5rem;border:1px solid var(--line);border-radius:10px;background:var(--paper);padding:.4rem 1rem}
    .cite summary{cursor:pointer;font-size:.85rem;color:var(--muted);font-weight:600;padding:.5rem 0;list-style:none}
    .cite summary::-webkit-details-marker{display:none}
    .cite summary::before{content:"❞ ";color:var(--accent)}
    .cite[open] summary{border-bottom:1px solid var(--line);margin-bottom:.6rem}
    .cite-text{font-size:.86rem;color:var(--ink);margin:.3rem 0 .6rem;line-height:1.5}
    .cite .copybtn{font-size:.78rem;color:var(--accent);border:1px solid var(--accent);background:transparent;
      border-radius:7px;padding:.35rem .8rem;cursor:pointer;font-family:inherit;margin-bottom:.5rem}
    .cite .copybtn:hover{background:var(--accent);color:#fff}
  </style>
  <script is:inline>
    document.addEventListener('click',function(e){
      var b=e.target.closest('.copybtn'); if(!b) return;
      var txt=b.getAttribute('data-copy')||'';
      navigator.clipboard.writeText(txt).then(function(){
        var old=b.textContent; b.textContent='¡Copiado!';
        setTimeout(function(){ b.textContent=old; },1600);
      }).catch(function(){});
    });
  </script>
</Base>
