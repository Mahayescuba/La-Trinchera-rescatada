---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fixCat, slugify, fmtDate } from '../lib/util';

const posts = await getCollection('posts');
const dated = posts.filter(p=>p.data.date).sort((a,b)=> (b.data.date||'').localeCompare(a.data.date||''));
const years:Record<string, typeof dated> = {};
for(const p of dated){ const y=String(new Date(p.data.date).getFullYear()); (years[y] ??= []).push(p); }
const yearKeys = Object.keys(years).sort((a,b)=> Number(b)-Number(a));
const total = dated.length;
---
<Base title="Archivo" description={`Los ${total} textos de La Trinchera ordenados por año.`}>
  <section class="wrap head">
    <p class="kicker">La Trinchera · Archivo</p>
    <h1>Archivo completo</h1>
    <p class="lede">{total} textos con fecha, ordenados del más reciente al más antiguo.</p>
    <nav class="years">
      {yearKeys.map(y=> <a href={`#${y}`}>{y} <span>({years[y].length})</span></a>)}
    </nav>
  </section>
  <section class="wrap arch">
    {yearKeys.map(y=> (
      <div class="yr">
        <h2 id={y}>{y} <span class="yr-n">{years[y].length} textos</span></h2>
        <ul>
          {years[y].map(p=> (
            <li>
              <a href={`/${p.slug}/`}>
                <span class="t">{p.data.title}</span>
                <span class="m">{p.data.author && `${p.data.author} · `}<span class="c">{fixCat(p.data.category)}</span> · {fmtDate(p.data.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
  <style>
    .head{padding:2.4rem 1.2rem 1rem;max-width:820px}
    .head .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;margin:0;font-weight:700}
    .head h1{font-size:clamp(2rem,6vw,2.8rem);margin:.15em 0 .1em}
    .head .lede{color:var(--muted);margin:.2rem 0 1rem}
    .years{display:flex;flex-wrap:wrap;gap:.4rem}
    .years a{padding:.4rem .8rem;border:1px solid var(--line);border-radius:20px;background:var(--paper);
      color:var(--accent);font-weight:700;font-size:.85rem;text-decoration:none}
    .years a span{color:var(--muted);font-weight:400}
    .years a:hover{background:var(--accent);color:#fff}
    .arch{max-width:820px;padding:1.4rem 1.2rem 2.6rem}
    .yr{margin-bottom:2rem}
    .yr h2{font-size:1.8rem;margin:0 0 .5rem;padding-bottom:.3rem;border-bottom:2px solid var(--accent);scroll-margin-top:1rem}
    .yr-n{font-family:-apple-system,system-ui,sans-serif;font-size:.8rem;color:var(--muted);font-weight:400;margin-left:.5rem}
    .yr ul{list-style:none;padding:0;margin:0}
    .yr li{border-bottom:1px solid var(--line)}
    .yr li a{display:flex;flex-direction:column;gap:.1rem;padding:.7rem 0;text-decoration:none;color:inherit}
    .yr li a:hover .t{color:var(--accent)}
    .t{font-family:Georgia,"Times New Roman",serif;font-size:1.08rem;font-weight:700;line-height:1.3}
    .m{color:var(--muted);font-size:.78rem}
    .m .c{color:var(--accent)}
  </style>
</Base>
