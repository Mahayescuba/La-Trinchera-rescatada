---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fixCat, slugify, fmtDate, excerpt, thumbData, initials, monoColor } from '../lib/util';
import { buildSeries } from '../lib/series';
import { pickCover } from '../lib/covers';
import authors from '../data/authors.json';
import sharp from 'sharp';
const posts = (await getCollection('posts')).sort((a,b)=> (b.data.date||'').localeCompare(a.data.date||''));
const withDate = posts.filter(p=>p.data.date);
// Hero: preferimos un texto reciente con imagen APAISADA (encaja en el hero
// ancho sin recortar). Si el más reciente es muy vertical, saltamos al
// siguiente. No se cambia ninguna imagen: solo se elige qué texto va grande.
async function aspectOf(img:string){ try{ const m=await sharp('public'+img).metadata(); return (m.width&&m.height)? m.width/m.height : 1; }catch{ return 1; } }
const latest = withDate[0];
let featured:any = null;
for(const p of withDate.slice(0,12)){
  if(!p.data.image) continue;
  if(await aspectOf(p.data.image) >= 1.3){ featured = p; break; }
}
if(!featured) featured = latest;
const heroIsLatest = featured === latest;
const featImg = featured?.data.image ? thumbData(featured.data.image, 1000) : null;
const rest = withDate.filter(p=>p!==featured);
const total = posts.length;
// autores con al menos un texto (para la línea de estadísticas)
const authorCounts:Record<string,number> = {};
for(const p of posts){ const a=p.data.author; if(a) authorCounts[a]=(authorCounts[a]||0)+1; }
const numAutores = Object.keys(authorCounts).length;
// "Explora por tema": categorías reales con su conteo
const catCounts:Record<string,number> = {};
for(const p of posts){ const c=fixCat(p.data.category); if(c && c!=='Sin categoría') catCounts[c]=(catCounts[c]||0)+1; }
const temas = Object.entries(catCounts).sort((a,b)=>b[1]-a[1]).slice(0,12).map(([name,count])=>({name,count}));
// Todas las series (con portada real de sus entregas) para la tira de la portada
const allSeries = buildSeries(posts).all;
const gradPairs = [['#8a2b2b','#3f1414'],['#6d4a5c','#2c1a22'],['#4f5d3a','#232a17'],['#3f5666','#1b262e'],['#7a5230','#33210f'],['#6b4f2a','#2e2210']];
const seriesCards = allSeries.map((s,i)=>({ s, cover: s.cover ? thumbData(s.cover, 520) : null, grad: gradPairs[i % gradPairs.length], init: (s.base.trim()[0]||'·').toUpperCase() }));
const numTemas = Object.keys(catCounts).length;
const moreList = rest.slice(9,24);
// "Del archivo, al azar": selección barajada (en build y en cada visita) de
// textos con imagen, de todo el archivo (no solo lo reciente).
const shuffle = <T,>(a:T[]):T[] => { a=a.slice(); for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; };
// Galería de recientes (sin el destacado del hero)
const mosaic = rest.slice(0,9).map((p)=>{
  const au = p.data.author || '';
  const prof:any = au ? ((authors as any)[slugify(au)] || {}) : {};
  return {
    p,
    src: p.data.image ? thumbData(p.data.image, 640).src : pickCover(p).file,
    dek: excerpt(p.body, 120, p.data.title),
    au, avatar: prof.img || '',
  };
});
const azarPool = shuffle(posts.filter(p=>p.data.image)).slice(0,20)
  .map((p,i)=>({ p, im: thumbData(p.data.image, 520), grad: gradPairs[i % gradPairs.length] }));
// "Voces del archivo": autores más prolíficos
---
<Base title={null} description="Archivo rescatado de La Trinchera: una plataforma cubana para el debate y la reflexión.">
  <header class="wrap mast">
    <p class="mast-kicker">Archivo rescatado · 2018–2022</p>
    <h1 class="mast-head">Muchas maneras <em>de estar</em></h1>
    <p class="mast-lede">Debate de ideas desde Cuba. Teoría, política y economía sin filiación: izquierda, derecha, centro, marxistas, libertarios.</p>
    <div class="dateline">
      <span><b>{total}</b> textos</span>
      <span><b>{numAutores}</b> firmas</span>
      <span><b>{allSeries.length}</b> series</span>
      <span><b>{numTemas}</b> temas</span>
      <span>Publicó 2018 — 2022 · <b>hoy en archivo</b></span>
    </div>
  </header>

  <aside class="wrap ednote">
    <div class="ednote-box">
      <p class="ednote-k">Nota del editor</p>
      <p><b>La Trinchera</b> se publicó desde Cuba entre 2018 y 2022. El sitio se perdió, pero pudo rescatarse <b>por completo</b>: aquí está el archivo íntegro, <b>en línea y abierto</b>, para quien quiera leerlo. Por ahora el proyecto <b>permanece cerrado</b> —no hay textos nuevos—; queda como memoria de aquel debate.</p>
      <p class="ednote-sign">— Miguel Alejandro Hayes<span>, fundador y editor principal</span></p>
    </div>
  </aside>

  {temas.length > 0 && (
    <nav class="wrap temas" aria-label="Explorar por tema">
      <span class="temas-l">Explora por tema</span>
      {temas.map(t=> (
        <a class="chip" href={`/categoria/${slugify(t.name)}/`}>{t.name}<span class="chip-n">{t.count}</span></a>
      ))}
      <a class="chip chip-all" href="/categorias/">Ver todas →</a>
    </nav>
  )}

  {featured && (
    <a class="wrap lead-hero" href={`/${featured.slug}/`}>
      <div class="lh-txt">
        <span class="lh-flag">{heroIsLatest ? 'Lo último publicado' : 'Destacado del archivo'}</span>
        <span class="lh-cat">{fixCat(featured.data.category)}</span>
        <h2>{featured.data.title}</h2>
        <p class="lh-dek">{excerpt(featured.body,190,featured.data.title)}</p>
        <span class="lh-meta">{featured.data.author && `${featured.data.author} · `}{fmtDate(featured.data.date)}</span>
      </div>
      <div class="lh-media" style={featImg ? `background-image:url(${featImg.src})` : 'background-image:linear-gradient(150deg,#8a2b2b,#3f1414)'}></div>
    </a>
  )}

  <section class="wrap">
    <div class="sec-head">
      <h2>Lo más reciente</h2>
      <a class="sec-all" href="/archivo/">Ver todo el archivo →</a>
    </div>
    <div class="mosaic">
      {mosaic.map(({p,src,dek,au,avatar})=> (
        <a class="mtile" href={`/${p.slug}/`}>
          <span class="mt-pic" style={`background-image:url(${src})`}></span>
          <div class="mt-cap">
            <span class="mt-cat">{fixCat(p.data.category)}</span>
            <h3>{p.data.title}</h3>
            <p class="mt-dek">{dek}</p>
            <span class="mt-by">
              {au && (avatar
                ? <img class="mt-av" src={avatar} alt="" width="24" height="24" loading="lazy" />
                : <span class="mt-av mt-mono" style={`background:${monoColor(au)}`}>{initials(au)}</span>)}
              <span class="mt-meta">{au && `${au} · `}{fmtDate(p.data.date)}</span>
            </span>
          </div>
        </a>
      ))}
    </div>
    {moreList.length>0 && (
      <ul class="morelist">
        {moreList.map(p=> (
          <li>
            <a href={`/${p.slug}/`}>
              <span class="ml-cat">{fixCat(p.data.category)}</span>
              <span class="ml-t">{p.data.title}</span>
              <span class="ml-m">{p.data.author && `${p.data.author} · `}{fmtDate(p.data.date)}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <div class="more-cta">
      <a class="cta" href="/archivo/">Ver más artículos →</a>
    </div>
  </section>

  {seriesCards.length>0 && (
    <section class="wrap series-home">
      <div class="sec-head">
        <h2>Series del archivo</h2>
        <a class="sec-all" href="/series/">Ver todas las series →</a>
      </div>
      <div class="sh-rail" id="seriesRail">
        {seriesCards.map(({s,cover,grad,init})=> (
          <a class="sh-card" href={`/${s.parts[0].slug}/`} data-series>
            <span class={`sh-cover${cover?'':' noimg'}`} style={cover
              ? `background-image:url(${cover.src})`
              : `background-image:linear-gradient(150deg,${grad[0]},${grad[1]})`}>
              {!cover && <span class="sh-init" aria-hidden="true">{init}</span>}
              <span class="sh-badge">{s.parts.length} entregas</span>
            </span>
            <span class="sh-title">{s.base}</span>
            {s.author && <span class="sh-au">{s.author}</span>}
          </a>
        ))}
      </div>
      <p class="sh-hint">Desliza para ver las {allSeries.length} series →</p>
    </section>
  )}

  {azarPool.length>0 && (
    <section class="wrap series-home azar">
      <div class="sec-head">
        <h2>Del archivo, al azar</h2>
        <a class="sec-all" href="/archivo/">Explorar todo →</a>
      </div>
      <div class="sh-rail" id="azarRail">
        {azarPool.map(({p,im})=> (
          <a class="sh-card" href={`/${p.slug}/`}>
            <span class="sh-cover" style={`background-image:url(${im.src})`}>
              <span class="sh-badge">{fixCat(p.data.category)}</span>
            </span>
            <span class="sh-title">{p.data.title}</span>
            <span class="sh-au">{p.data.author && `${p.data.author} · `}{fmtDate(p.data.date)}</span>
          </a>
        ))}
      </div>
      <p class="sh-hint">Una selección que cambia en cada visita →</p>
    </section>
  )}

  <script is:inline>
    /* barajar en cada visita: series y selección al azar */
    (function(){
      function shuffleRail(id){var r=document.getElementById(id);if(!r)return;
        var k=[].slice.call(r.children);
        for(var i=k.length-1;i>0;i--){var j=Math.random()*(i+1)|0;var t=k[i];k[i]=k[j];k[j]=t;}
        k.forEach(function(el){r.appendChild(el);});}
      shuffleRail('seriesRail'); shuffleRail('azarRail');
    })();
  </script>

  <style>
    /* mancheta / masthead */
    .mast{padding:clamp(1.6rem,4vw,2.6rem) 1.2rem 1.2rem}
    .mast-kicker{font-family:var(--display);color:var(--accent);text-transform:uppercase;letter-spacing:.16em;
      font-size:.74rem;font-weight:700;margin:0 0 .4rem}
    .mast-head{font-family:var(--display);font-weight:900;font-size:clamp(2.4rem,8vw,4.6rem);letter-spacing:-.02em;
      line-height:.92;margin:0;max-width:16ch}
    .mast-head em{font-style:italic;font-weight:500;color:var(--accent)}
    .mast-lede{color:var(--muted);max-width:60ch;margin:.9rem 0 1rem;font-size:1.05rem}
    .dateline{display:flex;flex-wrap:wrap;gap:.4rem 1.4rem;padding:.7rem 0 0;font-size:.72rem;font-weight:600;
      letter-spacing:.1em;text-transform:uppercase;color:var(--muted);border-top:1px solid var(--line)}
    .dateline b{color:var(--accent);font-family:var(--display)}
    /* en móvil, la mancheta se centra (columna única) */
    @media (max-width:560px){
      .mast{text-align:center}
      .mast-head{max-width:none}
      .mast-lede{max-width:40ch;margin-left:auto;margin-right:auto}
      .dateline{justify-content:center}
    }
    /* nota del editor */
    .ednote{padding-top:.9rem}
    .ednote-box{max-width:760px;border:1px solid var(--line);border-left:3px solid var(--accent);
      border-radius:8px;background:var(--paper);padding:.95rem 1.15rem}
    .ednote-k{font-family:var(--display);color:var(--accent);text-transform:uppercase;letter-spacing:.14em;
      font-size:.7rem;font-weight:700;margin:0 0 .45rem}
    .ednote-box p{margin:.2rem 0;color:var(--muted);font-size:.96rem;line-height:1.6}
    .ednote-box p b{color:var(--ink);font-weight:600}
    .ednote-sign{margin-top:.7rem!important;font-family:var(--display);font-style:italic;color:var(--ink);font-size:1rem}
    .ednote-sign span{color:var(--muted);font-style:normal;font-size:.85em}

    .temas{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;padding:.4rem 1.2rem 2rem}
    .temas-l{font-size:.72rem;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);font-weight:700;margin-right:.3rem}
    .chip{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .8rem;border:1px solid var(--line);border-radius:20px;
      background:var(--paper);color:var(--ink);font-size:.85rem;transition:.15s}
    .chip:hover{border-color:var(--accent);color:var(--accent)}
    .chip-n{color:var(--muted);font-size:.72rem;font-variant-numeric:tabular-nums}
    .chip:hover .chip-n{color:var(--accent)}
    .chip-all{color:var(--accent);font-weight:600}

    /* hero partido: texto | imagen (columna alta, muestra la obra completa) */
    .lead-hero{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;margin-bottom:2.4rem;
      background:var(--paper);border:1px solid var(--line);border-radius:10px;overflow:hidden;min-height:clamp(320px,40vw,500px)}
    .lead-hero .lh-txt{padding:clamp(1.4rem,3vw,2.4rem);display:flex;flex-direction:column;justify-content:center}
    .lh-flag{display:inline-block;align-self:flex-start;font-size:.64rem;text-transform:uppercase;letter-spacing:.14em;font-weight:700;
      color:#fff;background:var(--accent);padding:.24rem .55rem;border-radius:4px;margin-bottom:.7rem}
    .lh-cat{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--accent)}
    .lead-hero h2{font-size:clamp(1.6rem,3.6vw,2.7rem);line-height:1.1;margin:.15em 0 .35em;color:var(--ink)}
    .lh-dek{color:var(--muted);font-size:1.02rem;margin:0 0 .6rem;max-width:44ch}
    .lh-meta{color:var(--muted);font-size:.82rem}
    .lh-media{background-size:cover;background-position:50% 28%;background-color:#1a1510;min-height:280px}
    @media (max-width:640px){ .lead-hero{grid-template-columns:1fr} .lh-media{order:-1;min-height:64vw} }

    /* galería: obra completa (contain) sobre panel oscuro + texto debajo */
    .mosaic{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;padding-bottom:1.4rem;align-items:stretch}
    .mtile{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);
      border-radius:9px;overflow:hidden;color:inherit;transition:transform .15s,box-shadow .15s}
    .mtile:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(40,25,20,.10)}
    .mt-pic{display:block;aspect-ratio:4/3;background-size:contain;background-position:center;background-repeat:no-repeat;background-color:#17120d}
    .mt-cap{padding:.7rem .85rem .85rem;display:flex;flex-direction:column;gap:.2rem;flex:1}
    .mt-cat{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--accent)}
    .mt-cap h3{font-family:var(--display);color:var(--ink);font-size:1.05rem;line-height:1.18;margin:.05rem 0;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .mtile:hover .mt-cap h3{color:var(--accent)}
    .mt-dek{color:var(--muted);font-size:.86rem;line-height:1.35;margin:.1rem 0 0;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .mt-by{display:flex;align-items:center;gap:.45rem;margin-top:auto;padding-top:.6rem}
    .mt-av{flex:0 0 auto;width:24px;height:24px;border-radius:50%;object-fit:cover;display:grid;place-items:center;
      font-size:.6rem;font-weight:700;color:#fff;font-family:var(--display)}
    .mt-meta{color:var(--muted);font-size:.74rem;line-height:1.3}
    @media (max-width:520px){ .mosaic{grid-template-columns:1fr} }

    /* continuación: más entradas recientes, en lista compacta */
    .morelist{list-style:none;margin:1.4rem 0 0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:0 2rem}
    .morelist li{border-top:1px solid var(--line)}
    .morelist a{display:grid;grid-template-columns:1fr auto;align-items:baseline;gap:.3rem 1rem;padding:.7rem 0;color:inherit}
    .ml-cat{grid-column:1;font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;color:var(--accent)}
    .ml-t{grid-column:1;font-family:var(--display);font-weight:600;font-size:1.02rem;line-height:1.2}
    .morelist a:hover .ml-t{color:var(--accent)}
    .ml-m{grid-column:1;color:var(--muted);font-size:.76rem}
    @media (max-width:640px){ .morelist{grid-template-columns:1fr;gap:0} }

    .sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin:0 0 1.1rem}
    .sec-head h2{font-size:1.5rem;margin:0}
    .sec-all{color:var(--accent);font-size:.85rem;font-weight:600}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.4rem;padding-bottom:2rem}
    .card{background:var(--paper);border:1px solid var(--line);border-radius:9px;overflow:hidden;display:flex;flex-direction:column;transition:.15s}
    .card:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.06)}
    .card-img{width:100%;height:150px;object-fit:cover;display:block;background:#efe9e0}
    .card-body{padding:.9rem 1rem 1.1rem;display:flex;flex-direction:column;gap:.35rem}
    .card-body h3{font-size:1.12rem;margin:.15em 0}
    .card-body p{color:var(--muted);font-size:.9rem;margin:0}
    .meta{color:var(--muted);font-size:.76rem;margin-top:auto;padding-top:.3rem}
    .more-cta{display:flex;justify-content:center;padding:.2rem 0 2.4rem}
    .cta{display:inline-block;padding:.7rem 1.5rem;border:1px solid var(--accent);border-radius:24px;
      background:var(--paper);color:var(--accent);font-weight:700;font-size:.92rem;transition:.15s}
    .cta:hover{background:var(--accent);color:#fff}

    .series-home{padding:1.6rem 1.2rem 0}
    .sh-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(210px,240px);gap:1rem;
      overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:.7rem;scrollbar-width:thin;overscroll-behavior-x:contain}
    .sh-card{scroll-snap-align:start;display:flex;flex-direction:column;gap:.35rem;text-decoration:none;color:inherit}
    .sh-cover{position:relative;display:block;aspect-ratio:5/4;border-radius:9px;background-size:cover;background-position:center;
      background-color:var(--line);border:1px solid var(--line);overflow:hidden}
    .sh-card:hover .sh-cover{box-shadow:0 8px 22px rgba(40,25,20,.14)}
    .sh-badge{position:absolute;left:.5rem;top:.5rem;font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;
      font-weight:700;color:#fff;background:rgba(20,8,8,.55);backdrop-filter:blur(2px);padding:.22rem .5rem;border-radius:5px}
    .sh-init{position:absolute;right:-.05em;bottom:-.32em;font-family:var(--display);font-weight:900;font-size:7rem;
      line-height:1;color:#fff;opacity:.16}
    .sh-title{font-family:var(--display);font-weight:700;font-size:1.08rem;line-height:1.18;margin-top:.1rem}
    .sh-card:hover .sh-title{color:var(--accent)}
    .sh-au{color:var(--muted);font-size:.78rem}
    .sh-hint{font-size:.74rem;color:var(--muted);margin:.4rem 0 0;font-weight:600}
    .azar{padding-bottom:2.8rem;border-top:1px solid var(--line);margin-top:2rem}
  </style>
</Base>
