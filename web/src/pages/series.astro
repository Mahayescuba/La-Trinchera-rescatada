---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { slugify, thumbData } from '../lib/util';
import { buildSeries } from '../lib/series';

const posts = await getCollection('posts');
const { all } = buildSeries(posts);
const totalParts = all.reduce((s,x)=>s+x.parts.length,0);
const gradPairs = [['#8a2b2b','#3f1414'],['#6d4a5c','#2c1a22'],['#4f5d3a','#232a17'],['#3f5666','#1b262e'],['#7a5230','#33210f'],['#6b4f2a','#2e2210']];
const cards = all.map((s,i)=>({ s, cover: s.cover ? thumbData(s.cover, 560) : null, grad: gradPairs[i % gradPairs.length], init: (s.base.trim()[0]||'·').toUpperCase() }));
---
<Base title="Series" description={`Las ${all.length} series del archivo de La Trinchera: debates y crónicas publicados por entregas.`}>
  <section class="wrap head">
    <p class="kicker">La Trinchera · Archivo</p>
    <h1>Series</h1>
    <p class="lede">{all.length} series reunidas a partir de la propia numeración de los autores: {totalParts} textos publicados por entregas. Debates que se extendieron en el tiempo y crónicas que volvían sobre lo mismo.</p>
  </section>
  <section class="wrap grid" id="seriesGrid">
    {cards.map(({s,cover,grad,init})=> (
      <article class="card">
        <a class="card-top" href={`/${s.parts[0].slug}/`}>
          <span class={`cover${cover?'':' noimg'}`} style={cover
            ? `background-image:url(${cover.src})`
            : `background-image:linear-gradient(150deg,${grad[0]},${grad[1]})`}>
            {!cover && <span class="cinit" aria-hidden="true">{init}</span>}
            <span class="n">{s.parts.length} entregas</span>
          </span>
          <h2>{s.base}</h2>
          {s.author && <span class="au">{s.author}</span>}
        </a>
        <ol class="parts">
          {s.parts.map((p,i)=> (
            <li><a href={`/${p.slug}/`}><span class="pn">{i+1}</span>{p.title}</a></li>
          ))}
        </ol>
      </article>
    ))}
  </section>
  <script is:inline>
    /* orden aleatorio y siempre cambiante en cada visita */
    (function(){var r=document.getElementById('seriesGrid');if(!r)return;
      var k=[].slice.call(r.children);
      for(var i=k.length-1;i>0;i--){var j=Math.random()*(i+1)|0;var t=k[i];k[i]=k[j];k[j]=t;}
      k.forEach(function(el){r.appendChild(el);});
    })();
  </script>
  <style>
    .head{padding:2.4rem 1.2rem 1rem;max-width:760px}
    .head .kicker{color:var(--accent);text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;margin:0;font-weight:700}
    .head h1{font-size:clamp(2rem,6vw,2.8rem);margin:.15em 0 .1em}
    .head .lede{color:var(--muted);margin:.2rem 0 1rem}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:1.1rem;padding:1.2rem 1.2rem 2.6rem}
    .card{background:var(--paper);border:1px solid var(--line);border-radius:11px;overflow:hidden;
      display:flex;flex-direction:column;gap:.5rem;padding:0 1.2rem 1.1rem}
    .card-top{text-decoration:none;color:inherit;display:flex;flex-direction:column;gap:.35rem}
    .cover{position:relative;display:block;margin:0 -1.2rem;aspect-ratio:16/9;background-size:cover;background-position:center;
      background-color:var(--line);overflow:hidden}
    .cinit{position:absolute;right:.02em;bottom:-.3em;font-family:var(--display);font-weight:900;font-size:9rem;line-height:1;color:#fff;opacity:.16}
    .n{position:absolute;left:.6rem;top:.6rem;font-size:.64rem;text-transform:uppercase;letter-spacing:.1em;color:#fff;font-weight:700;
      background:rgba(20,8,8,.55);backdrop-filter:blur(2px);padding:.22rem .55rem;border-radius:5px}
    .card h2{font-family:var(--display);font-size:1.3rem;line-height:1.2;margin:.55rem 0 .1rem}
    .card-top:hover h2{color:var(--accent)}
    .au{color:var(--muted);font-size:.82rem}
    .parts{list-style:none;margin:.2rem 0 0;padding:0}
    .parts li{border-top:1px solid var(--line)}
    .parts li a{display:flex;gap:.6rem;align-items:baseline;padding:.4rem 0;text-decoration:none;color:inherit;font-size:.9rem;line-height:1.3}
    .parts li a:hover{color:var(--accent)}
    .pn{flex:0 0 auto;width:1.5rem;height:1.5rem;display:grid;place-items:center;border-radius:50%;
      background:var(--bg);color:var(--muted);font-size:.7rem;font-weight:700;font-variant-numeric:tabular-nums}
    @media (max-width:560px){ .grid{grid-template-columns:1fr} }
  </style>
</Base>
