---
// Galería editorial: cada obra se muestra COMPLETA (contain) sobre un panel
// oscuro tipo museo, con el texto debajo — nunca se recorta la obra.
import { fixCat, fmtDate, excerpt, thumbData } from '../lib/util';
import { pickCover } from '../lib/covers';
const { items } = Astro.props;
const tiles = items.map((p:any,i:number)=>{
  const im = p.data.image ? thumbData(p.data.image,640) : null;
  return { p, src: im ? im.src : pickCover(p).file, feat: i===0 };
});
---
<div class="pm">
  {tiles.map(({p,src,feat}:any)=> (
    <a class={`pm-tile${feat?' feat':''}`} href={`/${p.slug}/`}>
      <span class="pm-pic" style={`background-image:url(${src})`}></span>
      <div class="pm-cap">
        <span class="pm-cat">{fixCat(p.data.category)}</span>
        <h3>{p.data.title}</h3>
        {feat && <p class="pm-dek">{excerpt(p.body,140,p.data.title)}</p>}
        <span class="pm-meta">{p.data.author && `${p.data.author} · `}{fmtDate(p.data.date)}</span>
      </div>
    </a>
  ))}
</div>
<style>
  .pm{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;align-items:start}
  .pm-tile{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);
    border-radius:9px;overflow:hidden;color:inherit;text-decoration:none;transition:transform .15s,box-shadow .15s}
  .pm-tile:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(40,25,20,.10)}
  .pm-pic{display:block;aspect-ratio:4/3;background-size:contain;background-position:center;background-repeat:no-repeat;
    background-color:#17120d}
  .pm-cap{padding:.7rem .85rem .85rem;display:flex;flex-direction:column;gap:.15rem}
  .pm-cat{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--accent)}
  .pm-cap h3{font-family:var(--display);color:var(--ink);font-size:1.05rem;line-height:1.18;margin:.05rem 0}
  .pm-tile:hover .pm-cap h3{color:var(--accent)}
  .pm-dek{color:var(--muted);font-size:.88rem;margin:.15rem 0 0}
  .pm-meta{color:var(--muted);font-size:.74rem;margin-top:.1rem}
  @media (max-width:520px){ .pm{grid-template-columns:1fr} }
</style>
