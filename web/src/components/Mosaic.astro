---
// Galería editorial: cada obra se muestra COMPLETA (contain) sobre un panel
// oscuro tipo museo, con el texto debajo — nunca se recorta la obra.
// Cada ficha lleva resumen (2 líneas) y firma con mini-foto del autor.
import { fixCat, fmtDate, excerpt, thumbData, slugify, initials, monoColor } from '../lib/util';
import { pickCover } from '../lib/covers';
import authors from '../data/authors.json';
const { items, showAuthor = true } = Astro.props;
const tiles = items.map((p:any)=>{
  const im = p.data.image ? thumbData(p.data.image,640) : null;
  const au = p.data.author || '';
  const prof:any = au ? ((authors as any)[slugify(au)] || {}) : {};
  return { p, src: im ? im.src : pickCover(p).file, dek: excerpt(p.body,120,p.data.title), au, avatar: prof.img || '' };
});
---
<div class="pm">
  {tiles.map(({p,src,dek,au,avatar}:any)=> (
    <a class="pm-tile" href={`/${p.slug}/`}>
      <span class="pm-pic" style={`background-image:url(${src})`}></span>
      <div class="pm-cap">
        <span class="pm-cat">{fixCat(p.data.category)}</span>
        <h3>{p.data.title}</h3>
        <p class="pm-dek">{dek}</p>
        <span class="pm-by">
          {showAuthor && au && (avatar
            ? <img class="pm-av" src={avatar} alt="" width="24" height="24" loading="lazy" />
            : <span class="pm-av pm-mono" style={`background:${monoColor(au)}`}>{initials(au)}</span>)}
          <span class="pm-meta">{showAuthor && au && `${au} · `}{fmtDate(p.data.date)}</span>
        </span>
      </div>
    </a>
  ))}
</div>
<style>
  .pm{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem;align-items:stretch}
  .pm-tile{display:flex;flex-direction:column;background:var(--paper);border:1px solid var(--line);
    border-radius:9px;overflow:hidden;color:inherit;text-decoration:none;transition:transform .15s,box-shadow .15s}
  .pm-tile:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(40,25,20,.10)}
  .pm-pic{display:block;aspect-ratio:4/3;background-size:contain;background-position:center;background-repeat:no-repeat;
    background-color:#17120d}
  .pm-cap{padding:.7rem .85rem .85rem;display:flex;flex-direction:column;gap:.2rem;flex:1}
  .pm-cat{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;font-weight:700;color:var(--accent)}
  .pm-cap h3{font-family:var(--display);color:var(--ink);font-size:1.05rem;line-height:1.18;margin:.05rem 0;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .pm-tile:hover .pm-cap h3{color:var(--accent)}
  .pm-dek{color:var(--muted);font-size:.86rem;line-height:1.35;margin:.1rem 0 0;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .pm-by{display:flex;align-items:center;gap:.45rem;margin-top:auto;padding-top:.6rem}
  .pm-av{flex:0 0 auto;width:24px;height:24px;border-radius:50%;object-fit:cover;display:grid;place-items:center;
    font-size:.6rem;font-weight:700;color:#fff;font-family:var(--display)}
  .pm-meta{color:var(--muted);font-size:.74rem;line-height:1.3}
  @media (max-width:520px){ .pm{grid-template-columns:1fr} }
</style>
