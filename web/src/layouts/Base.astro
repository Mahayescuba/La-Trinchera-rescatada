---
const { title, description, image, type = 'website' } = Astro.props;
const site = 'La Trinchera';
const fullTitle = title ? `${title} — ${site}` : site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image || '/og-default.png', Astro.site).href;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#8a2b2b" />
<script is:inline>/* fijar el tema antes de pintar para evitar parpadeo */try{var _t=localStorage.getItem('theme');if(_t)document.documentElement.dataset.theme=_t;}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&display=swap" />
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical.href} />
<meta property="og:site_name" content={site} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title || site} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical.href} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title || site} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
<link rel="alternate" type="application/rss+xml" title={site} href={new URL('/rss.xml', Astro.site).href} />
<style is:global>
  :root{ --ink:#1a1714; --muted:#6b625a; --line:#e7e0d6; --bg:#fbf9f5; --paper:#fff; --accent:#8a2b2b; --mono-ink:#fbf6ef;
    --display:"Fraunces",Georgia,"Times New Roman",serif; --read:Georgia,"Times New Roman",serif; }
  @media (prefers-color-scheme:dark){ :root:not([data-theme="light"]){
    --ink:#ece5db; --muted:#b3a99e; --line:#352d27; --bg:#191512; --paper:#221d19; --accent:#d0685f; }
  }
  :root[data-theme="dark"]{
    --ink:#ece5db; --muted:#b3a99e; --line:#352d27; --bg:#191512; --paper:#221d19; --accent:#d0685f; }
  *{box-sizing:border-box}
  [hidden]{display:none!important}   /* que el atributo hidden gane sobre display:flex/grid */
  :focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
  .skip{position:absolute;left:.6rem;top:-3rem;z-index:100;background:var(--accent);color:#fff;
    padding:.55rem .9rem;border-radius:8px;font-size:.85rem;font-weight:600;transition:top .15s}
  .skip:focus{top:.6rem}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.65;}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1080px;margin:0 auto;padding:0 1.2rem}
  header.site{border-bottom:1px solid var(--line);background:var(--paper)}
  header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 1.2rem}
  .brand{font-family:var(--display);font-weight:700;font-size:1.75rem;letter-spacing:.2px;font-optical-sizing:auto}
  .brand small{display:block;font-size:.62rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:2px}
  nav.main{display:flex;flex-wrap:wrap;gap:.1rem .2rem;justify-content:flex-end}
  nav.main a{font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:.5rem .55rem;line-height:1.2}
  nav.main a:hover{color:var(--accent)}
  .theme-btn{background:none;border:0;cursor:pointer;color:var(--muted);font-size:1.05rem;line-height:1;padding:.4rem .5rem;border-radius:8px}
  .theme-btn:hover{color:var(--accent);background:var(--bg)}
  footer.site{border-top:1px solid var(--line);margin-top:3rem;background:var(--paper);color:var(--muted);font-size:.82rem}
  footer.site .wrap{padding:2rem 1.2rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
  footer.site .fnav{display:flex;flex-wrap:wrap;gap:.1rem .3rem;align-items:center}
  footer.site .fnav a{padding:.4rem .55rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:.72rem}
  footer.site .fnav a:hover{color:var(--accent)}
  h1,h2,h3{font-family:var(--display);line-height:1.15;font-optical-sizing:auto;letter-spacing:-.01em}
  .cat{display:inline-block;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600}
  @media (max-width:640px){
    header.site .wrap{flex-wrap:wrap;padding:.9rem 1.2rem}
    nav.main{width:100%;justify-content:flex-start;gap:.05rem .1rem}
    nav.main a{font-size:.74rem;padding:.5rem .5rem}
    .brand{font-size:1.4rem}
  }
  #toTop{position:fixed;right:1.1rem;bottom:1.1rem;width:44px;height:44px;border-radius:50%;
    border:1px solid var(--line);background:var(--paper);color:var(--accent);font-size:1.25rem;line-height:1;
    cursor:pointer;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;box-shadow:0 4px 14px rgba(0,0,0,.12);z-index:50}
  #toTop.show{opacity:1;pointer-events:auto}
  #toTop:hover{background:var(--accent);color:#fff;transform:translateY(-2px)}
  @media print{ #toTop{display:none} }
</style>
</head>
<body>
<a class="skip" href="#main">Saltar al contenido</a>
<header class="site"><div class="wrap">
  <a class="brand" href="/">La Trinchera<small>muchas maneras de estar</small></a>
  <nav class="main" aria-label="Navegación principal">
    <a href="/">Inicio</a>
    <a href="/categoria/politica-en-cuba/">Política</a>
    <a href="/categoria/economia-en-cuba/">Economía</a>
    <a href="/categoria/marxismo/">Marxismo</a>
    <a href="/categoria/cultura/">Cultura</a>
    <a href="/categorias/">Temas</a>
    <a href="/autores/">Autores</a>
    <a href="/sobre/">Sobre</a>
    <a href="/buscar/">Buscar</a>
    <button id="themeToggle" class="theme-btn" type="button" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro/oscuro">☾</button>
  </nav>
</div></header>
<main id="main"><slot /></main>
<footer class="site"><div class="wrap">
  <div>
    <div>La Trinchera — archivo rescatado. {new Date().getFullYear()}</div>
    <div>Un proyecto colaborativo cubano para el debate y la reflexión.</div>
  </div>
  <nav class="fnav">
    <a href="/">Inicio</a>
    <a href="/autores/">Autores</a>
    <a href="/categorias/">Categorías</a>
    <a href="/series/">Series</a>
    <a href="/archivo/">Archivo</a>
    <a href="/buscar/">Buscar</a>
    <a href="/sobre/">Sobre</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</div></footer>
<button id="toTop" aria-label="Volver arriba" title="Volver arriba">↑</button>
<script is:inline>
  (function(){var b=document.getElementById('themeToggle');if(!b)return;
    function cur(){return document.documentElement.dataset.theme || (window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light');}
    function icon(){b.textContent = cur()==='dark' ? '☀' : '☾';}
    icon();
    b.addEventListener('click',function(){
      var next = cur()==='dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try{localStorage.setItem('theme',next);}catch(e){}
      icon();
    });
  })();
</script>
<script is:inline>
  (function(){var b=document.getElementById('toTop');if(!b)return;
    function t(){b.classList.toggle('show',window.scrollY>500);}
    window.addEventListener('scroll',t,{passive:true});t();
    b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
  })();
</script>
</body>
</html>
