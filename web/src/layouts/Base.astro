---
const { title, description } = Astro.props;
const site = 'La Trinchera';
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title ? `${title} — ${site}` : site}</title>
{description && <meta name="description" content={description} />}
<style is:global>
  :root{ --ink:#1a1714; --muted:#6b625a; --line:#e7e0d6; --bg:#fbf9f5; --paper:#fff; --accent:#8a2b2b; }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.65;}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1080px;margin:0 auto;padding:0 1.2rem}
  header.site{border-bottom:1px solid var(--line);background:var(--paper)}
  header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 1.2rem}
  .brand{font-family:Georgia,"Times New Roman",serif;font-weight:700;font-size:1.7rem;letter-spacing:.5px}
  .brand small{display:block;font-size:.62rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:2px}
  nav.main a{font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);margin-left:1.1rem}
  nav.main a:hover{color:var(--accent)}
  footer.site{border-top:1px solid var(--line);margin-top:3rem;background:var(--paper);color:var(--muted);font-size:.82rem}
  footer.site .wrap{padding:2rem 1.2rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
  h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.2}
  .cat{display:inline-block;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600}
  @media (max-width:640px){ nav.main a{margin-left:.7rem;font-size:.72rem} .brand{font-size:1.4rem} }
</style>
</head>
<body>
<header class="site"><div class="wrap">
  <a class="brand" href="/">La Trinchera<small>muchas maneras de estar</small></a>
  <nav class="main">
    <a href="/">Inicio</a>
    <a href="/categoria/politica-en-cuba/">Política</a>
    <a href="/categoria/economia-en-cuba/">Economía</a>
    <a href="/categoria/marxismo/">Marxismo</a>
    <a href="/categoria/cultura/">Cultura</a>
    <a href="/buscar/">Buscar</a>
  </nav>
</div></header>
<main><slot /></main>
<footer class="site"><div class="wrap">
  <div>La Trinchera — archivo rescatado. {new Date().getFullYear()}</div>
  <div>Un proyecto colaborativo cubano para el debate y la reflexión.</div>
</div></footer>
</body>
</html>
