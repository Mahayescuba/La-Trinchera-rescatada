---
const { title, description, image, type = 'website' } = Astro.props;
const site = 'La Trinchera';
const fullTitle = title ? `${title} — ${site}` : site;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical.href} />
<meta property="og:site_name" content={site} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title || site} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical.href} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title || site} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}
<link rel="alternate" type="application/rss+xml" title={site} href={new URL('/rss.xml', Astro.site).href} />
<style is:global>
  :root{ --ink:#1a1714; --muted:#6b625a; --line:#e7e0d6; --bg:#fbf9f5; --paper:#fff; --accent:#8a2b2b; }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);
    font-family:-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.65;}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1080px;margin:0 auto;padding:0 1.2rem}
  header.site{border-bottom:1px solid var(--line);background:var(--paper)}
  header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.1rem 1.2rem}
  .brand{font-family:Georgia,"Times New Roman",serif;font-weight:700;font-size:1.7rem;letter-spacing:.5px}
  .brand small{display:block;font-size:.62rem;font-weight:400;letter-spacing:.22em;text-transform:uppercase;color:var(--muted);margin-top:2px}
  nav.main{display:flex;flex-wrap:wrap;gap:.1rem .2rem;justify-content:flex-end}
  nav.main a{font-size:.82rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:.5rem .55rem;line-height:1.2}
  nav.main a:hover{color:var(--accent)}
  footer.site{border-top:1px solid var(--line);margin-top:3rem;background:var(--paper);color:var(--muted);font-size:.82rem}
  footer.site .wrap{padding:2rem 1.2rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:1rem}
  footer.site .fnav{display:flex;flex-wrap:wrap;gap:.1rem .3rem;align-items:center}
  footer.site .fnav a{padding:.4rem .55rem;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:.72rem}
  footer.site .fnav a:hover{color:var(--accent)}
  h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.2}
  .cat{display:inline-block;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600}
  @media (max-width:640px){
    header.site .wrap{flex-wrap:wrap;padding:.9rem 1.2rem}
    nav.main{width:100%;justify-content:flex-start;gap:.05rem .1rem}
    nav.main a{font-size:.74rem;padding:.5rem .5rem}
    .brand{font-size:1.4rem}
  }
  #toTop{position:fixed;right:1.1rem;bottom:1.1rem;width:44px;height:44px;border-radius:50%;
    border:1px solid var(--line);background:var(--paper);color:var(--accent);font-size:1.25rem;line-height:1;
    cursor:pointer;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;box-shadow:0 4px 14px rgba(0,0,0,.12);z-index:50}
  #toTop.show{opacity:1;pointer-events:auto}
  #toTop:hover{background:var(--accent);color:#fff;transform:translateY(-2px)}
  @media print{ #toTop{display:none} }
</style>
</head>
<body>
<header class="site"><div class="wrap">
  <a class="brand" href="/">La Trinchera<small>muchas maneras de estar</small></a>
  <nav class="main">
    <a href="/">Inicio</a>
    <a href="/categoria/politica-en-cuba/">Política</a>
    <a href="/categoria/economia-en-cuba/">Economía</a>
    <a href="/categoria/marxismo/">Marxismo</a>
    <a href="/categoria/cultura/">Cultura</a>
    <a href="/categorias/">Temas</a>
    <a href="/autores/">Autores</a>
    <a href="/sobre/">Sobre</a>
    <a href="/buscar/">Buscar</a>
  </nav>
</div></header>
<main><slot /></main>
<footer class="site"><div class="wrap">
  <div>
    <div>La Trinchera — archivo rescatado. {new Date().getFullYear()}</div>
    <div>Un proyecto colaborativo cubano para el debate y la reflexión.</div>
  </div>
  <nav class="fnav">
    <a href="/">Inicio</a>
    <a href="/autores/">Autores</a>
    <a href="/categorias/">Categorías</a>
    <a href="/archivo/">Archivo</a>
    <a href="/buscar/">Buscar</a>
    <a href="/sobre/">Sobre</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</div></footer>
<button id="toTop" aria-label="Volver arriba" title="Volver arriba">↑</button>
<script is:inline>
  (function(){var b=document.getElementById('toTop');if(!b)return;
    function t(){b.classList.toggle('show',window.scrollY>500);}
    window.addEventListener('scroll',t,{passive:true});t();
    b.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});
  })();
</script>
</body>
</html>
